{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "checkJs": false
  },
  "include": ["src/**/*", "vite.config.js", "eslint.config.js"],
  "exclude": ["node_modules", "dist", "app"]
}
